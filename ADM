-- Player List
local List = Instance.new("ScrollingFrame")
List.Size = UDim2.new(1,-20,0,130)
List.Position = UDim2.new(0,10,0,300)
List.CanvasSize = UDim2.new(0,0,0,0)
List.ScrollBarImageTransparency = 0.2
List.BackgroundColor3 = Color3.fromRGB(35,35,35)
List.Parent = Main
List.BorderSizePixel = 0
Instance.new("UICorner", List)

local layout = Instance.new("UIListLayout", List)
layout.Padding = UDim.new(0,6)

local SelectedPlayer

local function refreshPlayers()
    List:ClearAllChildren()
    layout.Parent = List

    for _,plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local b = Instance.new("TextButton")
            b.Size = UDim2.new(1,-10,0,36)
            b.Text = plr.Name
            b.BackgroundColor3 = Color3.fromRGB(90,120,70)
            b.TextColor3 = Color3.new(1,1,1)
            b.Font = Enum.Font.Gotham
            b.TextSize = 14
            b.Parent = List
            b.BorderSizePixel = 0
            Instance.new("UICorner", b)

            b.MouseButton1Click:Connect(function()
                SelectedPlayer = plr
                PlayerLabel.Text = "SELECTED: "..plr.Name
            end)
        end
    end

    task.wait()
    List.CanvasSize = UDim2.new(0,0,0,layout.AbsoluteContentSize.Y + 10)
end

Players.PlayerAdded:Connect(refreshPlayers)
Players.PlayerRemoving:Connect(refreshPlayers)
refreshPlayers()

-- Slot Logic
AddPet.MouseButton1Click:Connect(function()
    for i,slot in ipairs(Slots) do
        if slot.Text == tostring(i) then
            slot.Text = "PET"
            slot.BackgroundColor3 = Color3.fromRGB(100,180,120)
            break
        end
    end
end)

RemovePet.MouseButton1Click:Connect(function()
    for i = #Slots,1,-1 do
        if Slots[i].Text == "PET" then
            Slots[i].Text = tostring(i)
            Slots[i].BackgroundColor3 = Color3.fromRGB(60,60,60)
            break
        end
    end
end)

-- Toggle Logic
local open = true
Toggle.MouseButton1Click:Connect(function()
    open = not open
    Main.Visible = open
    Toggle.Text = open and "CLOSE TRADE" or "OPEN TRADE"
end)

